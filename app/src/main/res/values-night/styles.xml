<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Pulse dark theme: avoids a white cold-start flash before Compose draws. -->
    <style name="Theme.pulse" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#09090F</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Widget Theme with Material 3 colors fallback for API < 31 (dark) -->
    <style name="Theme.Widget.pulse" parent="@android:style/Theme.DeviceDefault">
        <item name="android:colorBackground">#111217</item>
    </style>
</resources>
